# Proyecto de Supabase propio (ver docs/DEPLOY.md). Si se dejan vacías,
# el cliente usa el proyecto administrado por Enter como respaldo.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

VITE_ENTER_ANALYTICS_ENABLED=false
VITE_ENTER_ANALYTICS_TOKEN=
VITE_ENTER_PROJECT_ID=
VITE_ENTER_ANALYTICS_ENDPOINT=https://api.enter.pro
VITE_ENTER_ANALYTICS_DEFINITIONS_ENDPOINT=
VITE_ENTER_ANALYTICS_DEBUG=false

# Clerk: clave pública; vacía mantiene disponible el análisis sin login.
VITE_CLERK_PUBLISHABLE_KEY=

# Opcionales: habilitar navegación Family solo tras comprobar Firebase.
VITE_SMARTGUARD_FAMILY_ENABLED=false
# URL HTTPS pública de UptimeRobot; vacía oculta el enlace de estado.
VITE_SMARTGUARD_STATUS_PAGE_URL=
# Telemetría Supabase opcional (no es Firebase Family ni su configuración nativa).
VITE_SMARTGUARD_TELEMETRY_URL=
VITE_SMARTGUARD_TELEMETRY_PUBLISHABLE_KEY=
