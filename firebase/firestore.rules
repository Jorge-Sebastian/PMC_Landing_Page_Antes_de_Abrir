rules_version = '2';
// Prototype contract: devices/{uid}: consent bool, shareWithAdmin bool,
// consentVersion integer=1, apkVersion string <=32, createdAt timestamp immutable,
// lastSeenAt server timestamp. All fields required; no private content.
// analyses/{id}: color enum, engineVersion string <=32, occurredAt timestamp,
// receivedAt server timestamp. Immutable events. No URL/message/domain fields.
// admins/{uid}: enabled bool; managed only from trusted provisioning.
// Pilot codes: sg_pilot_codes/{sha256}: plan, usedBy, redeemedAt. Seeded only by an operator.
// sg_pilot_access/{uid}: plan, codeHash, startsAt. Valid for 30 days from startsAt.
// sg_pilot_accounts/{uid} and sg_pilot_trials/{uid}: immutable server timestamps.
// sg_pilot_testers/{uid}: enabled bool. Only the project operator can grant it.
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function owner(uid) { return signedIn() && request.auth.uid == uid; }
  function admin() {
   return signedIn() && request.auth.token.email_verified == true
    && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
  }
  function version(v) { return v is string && v.size() > 0 && v.size() <= 32 && v.matches('^[0-9][0-9A-Za-z._-]*$'); }
  function validDevice(d) {
   return d.keys().hasAll(['consent','shareWithAdmin','consentVersion','apkVersion','createdAt','lastSeenAt'])
    && d.keys().hasOnly(['consent','shareWithAdmin','consentVersion','apkVersion','createdAt','lastSeenAt'])
    && d.consent is bool && d.shareWithAdmin is bool && d.consentVersion == 1
    && version(d.apkVersion) && d.createdAt is timestamp && d.lastSeenAt == request.time
    && (d.consent || !d.shareWithAdmin);
  }
  function shared(d) { return d.consent == true && d.shareWithAdmin == true; }
  function parentConsented(uid) { return get(/databases/$(database)/documents/devices/$(uid)).data.consent == true; }
  function parentShared(uid) { return shared(get(/databases/$(database)/documents/devices/$(uid)).data); }
  function validAnalysis(d) {
   return d.keys().hasAll(['color','engineVersion','occurredAt','receivedAt'])
    && d.keys().hasOnly(['color','engineVersion','occurredAt','receivedAt'])
    && d.color in ['green','orange','red'] && version(d.engineVersion)
    && d.occurredAt is timestamp && d.occurredAt <= request.time
    && d.occurredAt >= request.time - duration.value(7, 'd') && d.receivedAt == request.time;
  }
  function qc(n) {return n is int && n>=0 && n<=1000000000;}
  function qb(b) {return b is list && b.size()==8 && qc(b[0]) && qc(b[1]) && qc(b[2]) && qc(b[3]) && qc(b[4]) && qc(b[5]) && qc(b[6]) && qc(b[7]);}
  function validQuality(d,day) {return d.keys().hasAll(['day','apkVersion','schemaVersion','revision','sdkLevel','serviceChecks','healthyChecks','eligibleNotifications','analysesOk','analysesFailed','alertsRequested','alertsPosted','eventsGenerated','eventsAcked','eventsPending','syncFailures','syncRetries','analysisDurationSumMs','analysisDurationCount','alertDurationSumMs','alertDurationCount','analysisBins','alertBins','receivedAt']) && d.keys().hasOnly(['day','apkVersion','schemaVersion','revision','sdkLevel','serviceChecks','healthyChecks','eligibleNotifications','analysesOk','analysesFailed','alertsRequested','alertsPosted','eventsGenerated','eventsAcked','eventsPending','syncFailures','syncRetries','analysisDurationSumMs','analysisDurationCount','alertDurationSumMs','alertDurationCount','analysisBins','alertBins','receivedAt'])
    && d.day == day
    && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
    && version(d.apkVersion)
    && d.schemaVersion == 1
    && qc(d.revision)
    && d.revision > 0
    && d.sdkLevel is int
    && d.sdkLevel >= 26
    && d.sdkLevel <= 80
    && qc(d.serviceChecks)
    && qc(d.healthyChecks)
    && qc(d.eligibleNotifications)
    && qc(d.analysesOk)
    && qc(d.analysesFailed)
    && qc(d.alertsRequested)
    && qc(d.alertsPosted)
    && qc(d.eventsGenerated)
    && qc(d.eventsAcked)
    && qc(d.eventsPending)
    && qc(d.syncFailures)
    && qc(d.syncRetries)
    && qc(d.analysisDurationSumMs)
    && qc(d.analysisDurationCount)
    && qc(d.alertDurationSumMs)
    && qc(d.alertDurationCount)
    && d.healthyChecks <= d.serviceChecks
    && d.alertsPosted <= d.alertsRequested
    && d.eventsAcked <= d.eventsGenerated
    && qb(d.analysisBins)
    && qb(d.alertBins)
    && d.receivedAt == request.time;}
  function qualityIncreasing(old,now) {return now.revision>old.revision && now.day==old.day
    && now.serviceChecks>=old.serviceChecks
    && now.healthyChecks>=old.healthyChecks
    && now.eligibleNotifications>=old.eligibleNotifications
    && now.analysesOk>=old.analysesOk
    && now.analysesFailed>=old.analysesFailed
    && now.alertsRequested>=old.alertsRequested
    && now.alertsPosted>=old.alertsPosted
    && now.eventsGenerated>=old.eventsGenerated
    && now.eventsAcked>=old.eventsAcked;}
  // Commercial records: client reads limited to owner or authenticated administrator.
  // All writes require Admin SDK / Cloud Functions; a modified APK cannot grant itself Premium.
  match /sg_accounts/{uid} {
    allow get: if owner(uid) || admin();
    allow list: if admin() && request.query.limit <= 100;
    allow write: if false;
    match /installations/{installationId} {
      allow get: if owner(uid) || admin();
      allow list: if (owner(uid) || admin()) && request.query.limit <= 20;
      allow write: if false;
    }
  }
  match /sg_entitlements/{uid} { allow get: if owner(uid) || admin(); allow list, write: if false; }
  match /sg_trials/{uid} { allow get: if owner(uid) || admin(); allow list, write: if false; }
  match /sg_payment_requests/{uid} { allow get: if owner(uid) || admin(); allow list: if admin() && request.query.limit <= 100; allow write: if false; }
  match /sg_activation_codes/{codeHash} { allow read, write: if false; }
  match /sg_payment_references/{referenceHash} { allow read, write: if false; }
  match /sg_admin_operations/{operationId} { allow read, write: if false; }
  match /sg_audit/{auditId} { allow read, write: if false; }
  match /sg_config/{configId} { allow read, write: if false; }
  function pilotCodePath(hash) {
    return /databases/$(database)/documents/sg_pilot_codes/$(hash);
  }
  function pilotAccessPath(uid) {
    return /databases/$(database)/documents/sg_pilot_access/$(uid);
  }
  function pilotTrialPath(uid) {
    return /databases/$(database)/documents/sg_pilot_trials/$(uid);
  }
  function validPilotTimestamp(data) {
    return data.keys().hasOnly(['startsAt']) && data.startsAt == request.time;
  }
  function validPilotCodeClaim(data, hash) {
    let access = getAfter(pilotAccessPath(request.auth.uid)).data;
    return hash.matches('^[0-9a-f]{64}$')
      && data.keys().hasOnly(['plan','usedBy','redeemedAt'])
      && resource.data.usedBy == null && resource.data.redeemedAt == null
      && data.plan == resource.data.plan && data.plan in ['individual','family']
      && data.usedBy == request.auth.uid && data.redeemedAt == request.time
      && access.codeHash == hash && access.plan == data.plan && access.startsAt == request.time;
  }
  function validPilotAccess(data, uid) {
    let code = pilotCodePath(data.codeHash);
    let claimed = getAfter(code).data;
    return data.keys().hasOnly(['plan','codeHash','startsAt'])
      && data.codeHash.matches('^[0-9a-f]{64}$') && data.plan in ['individual','family']
      && data.startsAt == request.time && get(code).data.usedBy == null
      && claimed.usedBy == uid && claimed.plan == data.plan && claimed.redeemedAt == request.time;
  }
  function pilotTester(uid) {
    let tester = /databases/$(database)/documents/sg_pilot_testers/$(uid);
    return owner(uid) && exists(tester) && get(tester).data.enabled == true;
  }
  function validPilotCodeReset(data, hash) {
    let access = pilotAccessPath(request.auth.uid);
    return pilotTester(request.auth.uid)
      && resource.data.usedBy == request.auth.uid && exists(access)
      && get(access).data.codeHash == hash && !existsAfter(access)
      && data.keys().hasOnly(['plan','usedBy','redeemedAt'])
      && data.plan == resource.data.plan && data.usedBy == null && data.redeemedAt == null;
  }
  function pilotAccessWasReset(uid, hash) {
    let code = pilotCodePath(hash);
    return get(code).data.usedBy == uid && getAfter(code).data.usedBy == null;
  }
  match /sg_pilot_testers/{uid} {
    allow get: if owner(uid);
  }
  match /sg_pilot_accounts/{uid} {
    allow get: if owner(uid) || admin();
    allow create: if owner(uid) && validPilotTimestamp(request.resource.data);
  }
  match /sg_pilot_trials/{uid} {
    allow get: if owner(uid);
    allow create: if owner(uid) && validPilotTimestamp(request.resource.data);
  }
  match /sg_pilot_codes/{hash} {
    allow get: if signedIn() && hash.matches('^[0-9a-f]{64}$') && resource.data.usedBy == null;
    allow update: if signedIn() && (validPilotCodeReset(request.resource.data, hash)
      || validPilotCodeClaim(request.resource.data, hash));
  }
  match /sg_pilot_access/{uid} {
    allow get: if owner(uid) || admin();
    allow create: if owner(uid) && validPilotAccess(request.resource.data, uid);
    allow update: if owner(uid)
      && resource.data.startsAt + duration.value(30, 'd') <= request.time
      && validPilotAccess(request.resource.data, uid);
    allow delete: if pilotTester(uid) && pilotAccessWasReset(uid, resource.data.codeHash);
  }
  function pilotFamilyEntitled(uid) {
    return (exists(pilotAccessPath(uid)) && get(pilotAccessPath(uid)).data.plan == 'family'
      && get(pilotAccessPath(uid)).data.startsAt + duration.value(30, 'd') > request.time)
      || (exists(pilotTrialPath(uid))
        && get(pilotTrialPath(uid)).data.startsAt + duration.value(15, 'd') > request.time
        && (!exists(pilotAccessPath(uid))
          || get(pilotAccessPath(uid)).data.startsAt + duration.value(30, 'd') <= request.time));
  }
  function commercialEnforced() {
    return exists(/databases/$(database)/documents/sg_config/commercial)
      && get(/databases/$(database)/documents/sg_config/commercial).data.enforced == true;
  }
  function familyEntitled(uid) {
    return !commercialEnforced()
      || (exists(/databases/$(database)/documents/sg_entitlements/$(uid))
        && get(/databases/$(database)/documents/sg_entitlements/$(uid)).data.plan in ['trial','family']
        && get(/databases/$(database)/documents/sg_entitlements/$(uid)).data.revoked == false
        && get(/databases/$(database)/documents/sg_entitlements/$(uid)).data.endsAt > request.time)
      || pilotFamilyEntitled(uid);
  }
  function roomHostEntitled(code) {
    // Do not read nested room/entitlement documents while commercial enforcement
    // is intentionally disabled for the legacy pilot.
    return !commercialEnforced()
      || familyEntitled(get(/databases/$(database)/documents/family_rooms/$(code)).data.hostUid);
  }
  match /admins/{uid} { allow get: if owner(uid); allow list, write: if false; }
  match /devices/{uid} {
   allow get: if owner(uid) || (admin() && shared(resource.data));
   allow list: if admin() && shared(resource.data) && request.query.limit <= 100;
   allow create: if owner(uid) && validDevice(request.resource.data)
    && request.resource.data.consent == true && request.resource.data.createdAt == request.time;
   allow update: if owner(uid) && validDevice(request.resource.data)
    && request.resource.data.createdAt == resource.data.createdAt;
   allow delete: if owner(uid);
   // Consented Android aggregates, never message text, URLs or personal identifiers.
   match /daily_metrics/{day} {
     allow get: if (owner(uid) && parentConsented(uid)) || (admin() && parentShared(uid));
     allow list: if ((owner(uid) && parentConsented(uid)) || (admin() && parentShared(uid))) && request.query.limit <= 35;
     allow create: if owner(uid) && parentConsented(uid) && validQuality(request.resource.data,day);
     allow update: if owner(uid) && parentConsented(uid) && validQuality(request.resource.data,day) && qualityIncreasing(resource.data,request.resource.data);
     allow delete: if owner(uid);
   }
   match /analyses/{id} {
    allow read: if (owner(uid) && parentConsented(uid)) || (admin() && parentShared(uid));
    allow create: if owner(uid) && parentConsented(uid) && id.matches('^[a-zA-Z0-9_-]{16,64}$') && validAnalysis(request.resource.data);
    allow update: if false;
    allow delete: if owner(uid);
   }
  }

  // SmartGuard Family V1 — guest-code access, NO public collection enumeration.
  // A 16-character Crockford-like random code is the Firestore document ID.
  // A bearer code gives access to room metadata; only active UIDs can see events.
  function familyCode(code) { return code.matches('^SG-[A-HJ-NP-Z2-9]{16}$'); }
  function validNickname(name) {
    return name is string && name.size() >= 1 && name.size() <= 48
      && name.matches('^[^<>\\n\\r]+$');
  }
  function validMember(m,role) {
    return m is map && m.keys().hasAll(['nickname','shareRisks','role','joinedAt'])
      && m.keys().hasOnly(['nickname','shareRisks','role','joinedAt','previousUids'])
      && validNickname(m.nickname) && m.shareRisks is bool
      && m.role == role && m.joinedAt is timestamp
      && (!m.keys().hasAny(['previousUids'])
        || (m.previousUids is list && m.previousUids.size() <= 20));
  }
  function roomMember(code) {
    return signedIn()
      && get(/databases/$(database)/documents/family_rooms/$(code)).data.members.keys().hasAny([request.auth.uid]);
  }
  function roomHost(code) {
    return signedIn()
      && get(/databases/$(database)/documents/family_rooms/$(code)).data.hostUid == request.auth.uid;
  }
  function familyOptIn(code) {
    return roomMember(code)
      && get(/databases/$(database)/documents/family_rooms/$(code)).data.members[request.auth.uid].shareRisks == true;
  }
  function validFamilyEvent(d) {
    return d.keys().hasAll(['memberUid','domain','color','source','createdAt','engineVersion'])
      && d.keys().hasOnly(['memberUid','domain','color','source','createdAt','engineVersion'])
      && d.memberUid == request.auth.uid && d.color == 'red'
      && d.domain is string && d.domain.size() <= 253
      && d.domain.matches('^[a-z0-9-]+(\\.[a-z0-9-]+)+$')
      && d.source in ['manual','notification']
      && version(d.engineVersion) && d.createdAt == request.time;
  }

  // A known member may regain their own membership on a new anonymous UID only
  // after an explicit approval by the original authenticated room host.
  // The host must atomically approve the private request and swap the two UIDs.
  function validFamilyRecoverySwap(code) {
    let proof = request.resource.data.lastRecovery;
    let oldProfile = resource.data.members[proof.oldUid];
    let newProfile = request.resource.data.members[proof.newUid];
    let receipt = getAfter(/databases/$(database)/documents/family_rooms/$(code)/recovery_requests/$(proof.newUid)).data;
    return request.auth.uid == resource.data.hostUid
      && proof is map
      && proof.keys().hasAll(['oldUid','newUid','approvedBy','approvedAt'])
      && proof.keys().hasOnly(['oldUid','newUid','approvedBy','approvedAt'])
      && proof.oldUid is string && proof.newUid is string
      && proof.oldUid != proof.newUid && proof.oldUid != resource.data.hostUid
      && proof.approvedBy == request.auth.uid && proof.approvedAt == request.time
      && resource.data.members.keys().hasAny([proof.oldUid])
      && !resource.data.members.keys().hasAny([proof.newUid])
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','lastRecovery'])
      && request.resource.data.members.diff(resource.data.members).addedKeys().size() == 1
      && request.resource.data.members.diff(resource.data.members).addedKeys().hasOnly([proof.newUid])
      && request.resource.data.members.diff(resource.data.members).removedKeys().size() == 1
      && request.resource.data.members.diff(resource.data.members).removedKeys().hasOnly([proof.oldUid])
      && request.resource.data.members.diff(resource.data.members).changedKeys().size() == 0
      && oldProfile.role == 'member' && validMember(newProfile, 'member')
      && newProfile.nickname == oldProfile.nickname
      && newProfile.shareRisks == oldProfile.shareRisks
      && newProfile.joinedAt == oldProfile.joinedAt
      && newProfile.keys().hasAny(['previousUids'])
      && newProfile.previousUids.size() == oldProfile.get('previousUids', []).size() + 1
      && newProfile.previousUids.hasAll(oldProfile.get('previousUids', []))
      && newProfile.previousUids.hasAny([proof.oldUid])
      && !oldProfile.get('previousUids', []).hasAny([proof.oldUid])
      && receipt.oldUid == proof.oldUid && receipt.newUid == proof.newUid
      && receipt.status == 'approved' && receipt.reviewedBy == request.auth.uid
      && receipt.reviewedAt == request.time;
  }

  match /family_rooms/{code} {
    // get(code) requires knowing a high-entropy code; list() is always denied.
    allow get: if signedIn() && familyCode(code);
    allow list: if false;
    allow create: if signedIn() && familyCode(code) && familyEntitled(request.auth.uid)
      && request.resource.data.keys().hasAll(['name','hostUid','members','open','createdAt'])
      && request.resource.data.keys().hasOnly(['name','hostUid','members','open','createdAt'])
      && validNickname(request.resource.data.name)
      && request.resource.data.hostUid == request.auth.uid
      && request.resource.data.createdAt == request.time
      && request.resource.data.open == true
      && request.resource.data.members is map
      && request.resource.data.members.keys().size() == 1
      && request.resource.data.members.keys().hasOnly([request.auth.uid])
      && validMember(request.resource.data.members[request.auth.uid],'host')
      && !request.resource.data.members[request.auth.uid].keys().hasAny(['previousUids'])
      && request.resource.data.members[request.auth.uid].joinedAt == request.time;
    allow update: if signedIn()
      && request.resource.data.keys().hasAll(resource.data.keys())
      && request.resource.data.keys().hasOnly(['name','hostUid','members','open','createdAt','lastRecovery'])
      && request.resource.data.hostUid == resource.data.hostUid
      && request.resource.data.createdAt == resource.data.createdAt
      && request.resource.data.members is map
      && (request.resource.data.members.keys().size() <= 10
         || (resource.data.members.keys().size() > 10
           && request.resource.data.members.keys().size() < resource.data.members.keys().size()))
      && (
        // Joining adds exactly the authenticated UID (transaction-safe capacity).
        (resource.data.open == true
          && resource.data.members.keys().size() < 10
          && familyEntitled(resource.data.hostUid)
          && !resource.data.members.keys().hasAny([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.diff(resource.data.members).addedKeys().size() == 1
          && request.resource.data.members.diff(resource.data.members).addedKeys().hasOnly([request.auth.uid])
          && request.resource.data.members.diff(resource.data.members).changedKeys().size() == 0
          && request.resource.data.members.diff(resource.data.members).removedKeys().size() == 0
          && validMember(request.resource.data.members[request.auth.uid],'member')
          && !request.resource.data.members[request.auth.uid].keys().hasAny(['previousUids'])
          && request.resource.data.members[request.auth.uid].joinedAt == request.time)
        ||
        // Existing member updates only their own nickname or consent.
        (resource.data.members.keys().hasAny([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.members.keys().size() == resource.data.members.keys().size()
          && validMember(request.resource.data.members[request.auth.uid],resource.data.members[request.auth.uid].role)
          && request.resource.data.members[request.auth.uid].joinedAt == resource.data.members[request.auth.uid].joinedAt
          && request.resource.data.members[request.auth.uid].get('previousUids', []) == resource.data.members[request.auth.uid].get('previousUids', []))
        ||
        // Host may remove one participant to free a seat (never itself).
        (request.auth.uid == resource.data.hostUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.diff(resource.data.members).removedKeys().size() == 1
          && request.resource.data.members.diff(resource.data.members).addedKeys().size() == 0
          && request.resource.data.members.diff(resource.data.members).changedKeys().size() == 0
          && request.resource.data.members.keys().hasAll([resource.data.hostUid]))
        ||
        // A non-host participant can leave the room independently.
        (request.auth.uid != resource.data.hostUid
          && resource.data.members.keys().hasAny([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.diff(resource.data.members).removedKeys().size() == 1
          && request.resource.data.members.diff(resource.data.members).removedKeys().hasOnly([request.auth.uid])
          && request.resource.data.members.diff(resource.data.members).addedKeys().size() == 0
          && request.resource.data.members.diff(resource.data.members).changedKeys().size() == 0)
        ||
        // Only the host can rename the room or close admission.
        (request.auth.uid == resource.data.hostUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','open'])
          && validNickname(request.resource.data.name)
          && request.resource.data.open is bool)
        ||
        // Recovery is host-approved and uses getAfter() to bind both writes.
        validFamilyRecoverySwap(code)
      );
    allow delete: if false;

    // Private re-entry requests. A room code and matching nickname are NOT
    // credentials: the original host must approve the transfer.
    match /recovery_requests/{uid} {
      allow get: if signedIn() && (owner(uid) || roomHost(code));
      allow list: if roomHost(code) && request.query.limit <= 30;
      allow create: if owner(uid) && familyCode(code)
        && request.resource.data.keys().hasAll(['oldUid','newUid','status','createdAt'])
        && request.resource.data.keys().hasOnly(['oldUid','newUid','status','createdAt'])
        && request.resource.data.newUid == uid
        && request.resource.data.oldUid is string
        && request.resource.data.oldUid != uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/family_rooms/$(code)).data.hostUid != request.resource.data.oldUid
        && get(/databases/$(database)/documents/family_rooms/$(code)).data.members.keys().hasAny([request.resource.data.oldUid])
        && !get(/databases/$(database)/documents/family_rooms/$(code)).data.members.keys().hasAny([uid]);
      allow update: if roomHost(code)
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt'])
        && request.resource.data.status in ['approved','rejected']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && (request.resource.data.status == 'rejected'
          || (getAfter(/databases/$(database)/documents/family_rooms/$(code)).data.lastRecovery.oldUid == resource.data.oldUid
              && getAfter(/databases/$(database)/documents/family_rooms/$(code)).data.lastRecovery.newUid == uid
              && getAfter(/databases/$(database)/documents/family_rooms/$(code)).data.lastRecovery.approvedAt == request.time
              && getAfter(/databases/$(database)/documents/family_rooms/$(code)).data.members.keys().hasAny([uid])
              && !getAfter(/databases/$(database)/documents/family_rooms/$(code)).data.members.keys().hasAny([resource.data.oldUid])));
      allow delete: if owner(uid) && resource.data.status in ['pending','rejected'];
    }

    match /risk_events/{eventId} {
      allow get: if roomMember(code) && roomHostEntitled(code);
      allow list: if roomMember(code) && roomHostEntitled(code) && request.query.limit <= 100;
      allow create: if familyOptIn(code) && roomHostEntitled(code)
        && eventId.matches('^[a-zA-Z0-9_-]{16,64}$')
        && validFamilyEvent(request.resource.data);
      allow update: if false;
      allow delete: if roomMember(code)
        && (resource.data.memberUid == request.auth.uid || roomHost(code)
          || get(/databases/$(database)/documents/family_rooms/$(code)).data.members[request.auth.uid].get('previousUids', []).hasAny([resource.data.memberUid]));
    }
  }

  match /{document=**} { allow read, write: if false; }
 }
}
