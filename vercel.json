{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:prod",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    { "source": "/familia/:path*", "destination": "/", "permanent": false },
    { "source": "/analizar/:path*", "destination": "/", "permanent": false },
    { "source": "/administrador/:path*", "destination": "/", "permanent": false },
    { "source": "/contacto", "destination": "/#contacto", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; style-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
